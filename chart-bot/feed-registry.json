{
  "feed": "chart-daily",
  "file": "chart-daily-observations.json",
  "owner": "Chart Bot",
  "rule": "CB-DAILY-V1",
  "softOnly": true,
  "neverElevateAlone": true,
  "routine": "chart-daily-refresh",
  "cadence": "Weekdays 2:24 PM PT after cash close; weekend/holiday keep last completed session",

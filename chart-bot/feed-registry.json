  "handoff": {
    "to": [
      "Rose - Option Trader 1",
      "Hal - Options Trader 2"
    ],
    "when": "material trend flips or newly UNAVAILABLE after weekday refresh",
    "quiet_if_unchanged": true,
    "never_elevates": true
  },
  "not_applicable": [
    "Databento",
    "Massive",
    "5/15/60-min bars",
    "weekly bars",
    "1-min RVOL",
    "pattern detector",
    "SOXX",
    "forecasts/probabilities",
    "push receiver",
    "changes API"

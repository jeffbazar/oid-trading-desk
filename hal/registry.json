      "role": "soft_a_annotate",
      "quotes_from": "rh-quotes",
      "quotes_owner": "rose",
      "doc": "hal/RH-QUOTES-READER.md"
    },
    {
      "id": "hal-x-scan",
      "file": "market-data/latest/hal-x-scan.json",
      "cadence": "every_2h_pt_0811_2011",

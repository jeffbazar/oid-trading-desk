    },
    {
      "id": "desk-catalysts",
      "file": "market-data/latest/desk-catalysts.json",
      "neverElevateAlone": true,
      "doc": "hal/DESK-CATALYSTS.md"
    },
    {
      "id": "fa-levels",
      "role": "reader",
      "writer": "Rose",
      "sharedQuota": true,
      "doc": "hal/FA-READER.md"
    }
  ],
  "docs": [
    "hal/README.md",
    "hal/HAL-CADENCE-V1.md",
    "hal/HAL-X-ALLOWLIST.md",
    "hal/FA-READER.md",

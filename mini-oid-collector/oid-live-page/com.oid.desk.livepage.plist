<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.oid.desk.livepage</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__HOME__/oid-live-page/livepage.py</string></array>
  <key>EnvironmentVariables</key><dict><key>OID_LIVEPAGE_HOST</key><string>127.0.0.1</string><key>OID_LIVEPAGE_PORT</key><string>8791</string><key>PYTHONUNBUFFERED</key><string>1</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/oid-live-page/logs/livepage.log</string>
  <key>StandardErrorPath</key><string>__HOME__/oid-live-page/logs/livepage.log</string>
</dict></plist>

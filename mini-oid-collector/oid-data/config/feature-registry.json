 "doc": "One row per score input. Weights are not logged per row (they are fixed by settings_version in score-config.json). Null values are omitted from JSONL rows; Parquet has every column. status: output | in_score | context | shadow | age. path is a dotted path into the score change row (comps.*, ctx.*); @news.* and @cs.* are filled by the snapshotter. Each feature names the age column that tells how old its value was. Shadow features are logged, never used by a live score until a promotion test passes.",
 "snapshot": {
  "every_s": 15,
  "profiles": {
   "core": "full row",
   "wide_full": "full row",
   "light": "lite row (score, light components, ages; no ctx/shadow)"
  }
 },

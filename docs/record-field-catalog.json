{
  "contract_version": "five-bot-field-catalog-v1",
  "status": "FIELD_CATALOG_PROPOSAL_NOT_FULL_PAYLOAD_JSON_SCHEMA",
  "envelope_required": [
    "record_type",
    "record_id",
    "revision",
    "producer",
    "schema_version",
    "rule_version",
    "entity_ids",
    "instrument_ids",
    "source_refs",
    "source_observed_at",
    "source_published_at",
    "received_at",
    "record_available_at",
    "evaluated_at",
    "session",
    "delay_class",
    "coverage_state",
    "data_status",
    "supersedes_revision",
    "correction_status",
    "next_review_at"
  ],
  "rules": [
    "Stable IDs, immutable revisions, separate latest-head pointers",
    "Unknowns null; financial values decimal strings with units/currency/basis",
    "One generated_at cannot refresh the ages of component sources",
    "Prediction probabilities null until a registered calibrated model covers that outcome/horizon",
    "Disclosure confidence, exposure confidence, impact direction, materiality and alert priority are separate",
    "Record availability for evaluation includes ingestion/processing latency; do not backdate",
    "Receipt acknowledgment, analysis completion, decision approval and paper transaction are distinct",
    "Critical quote evidence includes source time, delay/session, exact contract and current bid/ask"
  ],
  "producer_payloads": {
    "chart": {
      "record_types": [
        "chart_setup"
      ],
      "fields": [
        "timeframe",
        "completed_bar_refs",
        "adjustment_basis",
        "features",
        "pivots_with_confirmation_times",
        "pattern_status",
        "trigger",

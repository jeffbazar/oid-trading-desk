        "macro_snapshot"
      ],
      "fields": [
        "release_id",
        "actuals_with_units",
        "original_prior",
        "revised_prior",
        "frozen_consensus_ref",
        "surprise",
        "market_transmission_refs",
        "daily_macro",
        "macro_tech",
        "input_scores",
        "reasoning",
        "tone_labels",
        "confidence_category",
        "stale_conflicting_inputs"
      ]
    },
    "news": {
      "record_types": [
        "news_event",
        "event_assessment",
        "company_relationship",
        "project_milestone"
      ],
      "fields": [
        "event_id",
